#!/bin/bash
# Keep this hook non-fatal and lightweight to avoid breaking chroot package setup.
set -e
TARGET="/usr/sbin/start-stop-daemon"
DIVERTED="${TARGET}.distrib"

echo "[dpkg-divert fix] Checking for start-stop-daemon state"
dpkg-divert --list "$TARGET" 2>/dev/null | grep -q "$TARGET" && echo "[dpkg-divert fix] diversion present" || echo "[dpkg-divert fix] no diversion"
rm -f "$TARGET" "$DIVERTED" 2>/dev/null || true
